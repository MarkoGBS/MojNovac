{
  "name": "student/money-manager",
  "description": "Jednostavna MVC aplikacija za upravljanje novcem",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "twig/twig": "^3.0",
    "phpoffice/phpspreadsheet": "^2.1 || ^3.0 || ^4.0 || ^5.0",
    "dompdf/dompdf": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
