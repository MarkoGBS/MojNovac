<!doctype html><html><head><meta charset="utf-8"><style>
body{font-family:DejaVu Sans,sans-serif;font-size:11px;color:#18212f}h1{font-size:20px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #cbd5e1;padding:7px;text-align:left}th{background:#e8eef8}
</style></head><body><h1>{{ title }}</h1><p>Generisano: {{ 'now'|date('d.m.Y H:i') }}</p><table><thead><tr>{% for h in headers %}<th>{{ h }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for value in row %}<td>{{ value }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ headers|length }}">Nema podataka.</td></tr>{% endfor %}</tbody></table></body></html>
