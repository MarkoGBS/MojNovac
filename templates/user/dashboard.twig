{% extends 'layouts/base.twig' %}
{% block title %}Moj pregled — {{ app_name }}{% endblock %}
{% block content %}
<h1>Moj novac</h1>

<section class="grid three">
{% for account in accounts %}
    <article class="card balance-card"><span>{{ account.name }}</span><strong>{{ account.balance|number_format(2, ',', '.') }} RSD</strong></article>
{% else %}<p>Nemate nijedan račun.</p>{% endfor %}
</section>

<details class="card"><summary>Dodaj račun</summary>
    <form class="form-row" method="post" action="{{ url('/accounts') }}">{{ csrf_field() }}
        <input name="name" placeholder="Naziv računa" required><button>Dodaj</button>
    </form>
</details>

<section class="grid three">
    <div class="form-card">
        <h2>Uplata / isplata</h2>
        <form method="post" action="{{ url('/money') }}">{{ csrf_field() }}
            <label>Operacija<select name="type"><option value="deposit">Uplata</option><option value="withdrawal">Isplata</option></select></label>
            <label>Račun<select name="account_id">{% for a in accounts %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}</select></label>
            <label>Kategorija<select name="category_id"><option value="0">Bez kategorije</option>{% for c in categories %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}</select></label>
            <label>Iznos<input type="number" name="amount" min="0.01" step="0.01" required></label>
            <button>Sačuvaj</button>
        </form>
    </div>
    <div class="form-card">
        <h2>Transfer</h2>
        <form method="post" action="{{ url('/transfer') }}">{{ csrf_field() }}
            <label>Sa računa<select name="source_id">{% for a in accounts %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}</select></label>
            <label>Na račun<select name="destination_id">{% for a in accounts %}<option value="{{ a.id }}">{{ a.name }}</option>{% endfor %}</select></label>
            <label>Iznos<input type="number" name="amount" min="0.01" step="0.01" required></label>
            <button>Prebaci</button>
        </form>
    </div>
    <div class="form-card">
        <h2>Podrška</h2>
        <form method="post" action="{{ url('/support') }}">{{ csrf_field() }}
            <label>Naslov<input name="subject" required></label>
            <label>Poruka<textarea name="message" required></textarea></label>
            <button>Pošalji</button>
        </form>
    </div>
</section>

<h2>Budžeti ovog meseca</h2>
<div class="table-wrap"><table><thead><tr><th>Kategorija</th><th>Budžet</th><th>Potrošeno</th><th>Preostalo</th></tr></thead><tbody>
{% for b in budgets %}<tr><td>{{ b.category_name }}</td><td>{{ b.amount|number_format(2, ',', '.') }}</td><td>{{ b.spent|number_format(2, ',', '.') }}</td><td>{{ b.remaining|number_format(2, ',', '.') }}</td></tr>
{% else %}<tr><td colspan="4">Menadžer još nije uneo budžet za ovaj mesec.</td></tr>{% endfor %}
</tbody></table></div>

<h2 id="transactions">Transakcije</h2>
<div class="table-wrap"><table><thead><tr><th>Datum</th><th>Račun</th><th>Tip</th><th>Kategorija</th><th>Iznos</th></tr></thead><tbody>
{% for t in transactions %}<tr><td>{{ t.created_at }}</td><td>{{ t.account_name }}{% if t.destination_name %} → {{ t.destination_name }}{% endif %}</td><td><span class="badge {{ t.type }}">{{ t.type }}</span></td><td>{{ t.category_name|default('-') }}</td><td>{{ t.amount|number_format(2, ',', '.') }} RSD</td></tr>
{% else %}<tr><td colspan="5">Nema transakcija.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.twig' with {pagination: transactionPagination, path: '/dashboard', parameter: 'transactions_page', fragment: 'transactions'} only %}

<h2 id="tickets">Moji zahtevi za podršku</h2>
{% set ticketStatuses = {'open': 'Otvoren', 'in_progress': 'U obradi', 'resolved': 'Rešen', 'closed': 'Zatvoren'} %}
{% for t in tickets %}
<article class="card">
    <h3>#{{ t.id }} — {{ t.subject }}</h3>
    <p class="muted">{{ t.created_at }} · {{ ticketStatuses[t.status]|default(t.status) }}</p>
    <p>{{ t.message|nl2br }}</p>
    {% if t.reply is not null %}
        <h4>Odgovor menadžera</h4>
        <p>{{ t.reply|nl2br }}</p>
        <p class="muted">{{ t.replied_by_name|default('Menadžer') }} · {{ t.replied_at }}</p>
    {% else %}<p class="muted">Menadžer još nije odgovorio.</p>{% endif %}
</article>
{% else %}<p>Još niste poslali zahtev za podršku.</p>{% endfor %}
{% include 'components/pagination.twig' with {pagination: ticketPagination, path: '/dashboard', parameter: 'tickets_page', fragment: 'tickets'} only %}
{% endblock %}
